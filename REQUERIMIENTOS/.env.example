# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - Cafetería U
# ============================================================================
# IMPORTANTE: Copia este archivo a .env y completa con tus valores reales
# NUNCA commits el archivo .env (contiene credenciales sensibles)
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# BASE DE DATOS MYSQL
# ─────────────────────────────────────────────────────────────────────────

# Host del servidor MySQL
# - localhost: Servidor MySQL en la misma máquina
# - 127.0.0.1: Alternativa para localhost
# - IP remota: Servidor MySQL en otra máquina
DB_HOST=localhost

# Usuario de MySQL
# - root: Usuario por defecto (cambiar en producción)
# - otro_usuario: Usuario específico creado en MySQL
DB_USER=root

# Contraseña de MySQL
# - Dejar vacío si no tiene contraseña (desarrollo local)
# - Usar contraseña fuerte en producción
DB_PASSWORD=

# Nombre de la base de datos
# - Debe existir en MySQL
# - Se crea con: CREATE DATABASE cafeteria;
DB_NAME=cafeteria

# ─────────────────────────────────────────────────────────────────────────
# AUTENTICACIÓN JWT
# ─────────────────────────────────────────────────────────────────────────

# Clave secreta para firmar tokens JWT
# IMPORTANTE: 
# - Usar cadena larga y aleatoria
# - Cambiar en producción
# - No compartir nunca
# - Ejemplo: openssl rand -hex 32
JWT_SECRET=tu_clave_secreta_aqui_cambiar_en_produccion

# ─────────────────────────────────────────────────────────────────────────
# SERVIDOR NODE.JS
# ─────────────────────────────────────────────────────────────────────────

# Entorno de ejecución
# - development: Modo desarrollo (logs verbosos)
# - production: Modo producción (optimizado)
NODE_ENV=development

# Puerto del servidor
# - 3000: Puerto por defecto
# - Cambiar si puerto está en uso
PORT=3000

# ─────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN ADICIONAL (opcional)
# ─────────────────────────────────────────────────────────────────────────

# Timeout de conexión a MySQL (ms)
# DB_CONNECTION_TIMEOUT=10000

# Máximo de conexiones en pool
# DB_CONNECTION_LIMIT=10

# URL del frontend (para CORS)
# FRONTEND_URL=http://localhost:3000

# ============================================================================
# EJEMPLO COMPLETO para desarrollo local:
# ============================================================================
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=cafeteria
# JWT_SECRET=desarrollo_clave_temporal
# NODE_ENV=development
# PORT=3000
# ============================================================================

# ============================================================================
# EJEMPLO para producción (cambiar valores):
# ============================================================================
# DB_HOST=db.produccion.com
# DB_USER=cafeteria_user
# DB_PASSWORD=contraseña_muy_segura_aleatorios_caracteres
# DB_NAME=cafeteria_prod
# JWT_SECRET=clave_larga_aleatoria_generada_con_openssl_rand_hex_32
# NODE_ENV=production
# PORT=3000
# ============================================================================

# ============================================================================
# GENERADOR DE JWT_SECRET SEGURO:
# ============================================================================
# Windows PowerShell:
#   [System.Convert]::ToHexString((1..32 | ForEach-Object {[byte](Get-Random -Maximum 256)}))
#
# Linux/Mac:
#   openssl rand -hex 32
# ============================================================================
